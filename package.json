{
  "name": "cafe-menu-app",
  "version": "1.0.0",
  "description": "Aplicación de menú de café con pedidos en tiempo real",
  "engines": {
    "node": ">=16.0.0"
  },
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "start": "node server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "seed": "node server/seed.js",
    "generate-secret": "node scripts/generate-jwt-secret.js",
    "test": "jest",
    "test:server": "jest --forceExit --detectOpenHandles",
    "test:client": "cd client && npm test",
    "install-deps": "npm install && cd client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "pino": "^10.3.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "cafe",
    "menu",
    "restaurant",
    "orders",
    "realtime"
  ],
  "author": "Tu Nombre",
  "license": "MIT"
}
